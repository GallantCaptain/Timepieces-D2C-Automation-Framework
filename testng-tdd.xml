<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
    TDD-only suite: plain TestNG classes (no Cucumber / no browser BDD scenarios).
    These are the "fast" non-BDD tests — API checks and pure unit tests.
    Run with:  ./mvnw clean test "-Dsurefire.suite=testng-tdd.xml"

    To run ONLY the API test, comment out the "Unit Executions" <test> block below
    (or vice-versa for the Twilio unit test).
-->
<suite name="Timepieces TDD Suite" parallel="none" data-provider-thread-count="8">

    <listeners>
        <listener class-name="com.timepieces.automation.listeners.RetryAnnotationTransformer" />
        <listener class-name="com.timepieces.automation.listeners.MetricsListener" />
    </listeners>

    <!-- Global Parameter read by BaseRunner (harmless for pure TestNG classes). -->
    <parameter name="environment" value="staging" />

    <test name="API Executions">
        <classes>
            <class name="com.timepieces.automation.tdd.api.SearchApiTest" />
            <class name="com.timepieces.automation.tdd.api.IdempotencyApiTest" />
        </classes>
    </test>

    <test name="Unit Executions">
        <classes>
            <class name="com.timepieces.automation.tdd.api.TwilioServiceTest" />
        </classes>
    </test>
</suite>