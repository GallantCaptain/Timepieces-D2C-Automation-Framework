# Copy this file to `.env` (gitignored) and fill in to enable emailed Allure
# reports on local/Docker runs. scripts/email_allure_report.py auto-loads it.
# Real environment variables always take precedence over this file.

# --- SMTP sender (required to actually send) ---
# Gmail / Google Workspace: host below, port 587, and a Google *App Password*
# (Account -> Security -> App passwords) as SMTP_PASSWORD (not your login password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.personal@gmail.com
SMTP_PASSWORD=your-16-char-app-password
# SMTP_STARTTLS=true        # default true (port 587)
# SMTP_SSL=false            # set true for implicit TLS (port 465)

# --- Message ---
MAIL_FROM=your.personal@gmail.com
MAIL_TO=167759523+GallantCaptain@users.noreply.github.com
# MAIL_MAX_ATTACH_MB=20     # local/docker attach the zipped report up to this size

# --- Zephyr Scale (test-case upload scripts) ---
# Consumed by scripts/add_*_tcs.py, which push BDD test cases to Zephyr Scale.
# PLACEHOLDER ONLY - never commit a real token here. This file is TRACKED; put the real
# value in .env, which is gitignored.
#
# History note (ISSUE-013): a live token was hardcoded in four of these scripts and is
# still present in git history. That is why they now read this env var and abort without
# it. Verify any token's status with:  py scripts/check_zephyr_token.py
ZEPHYR_TOKEN=your-zephyr-scale-api-token
