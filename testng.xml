<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Timepieces Automation Suite" parallel="none" data-provider-thread-count="5">

    <listeners>
        <listener class-name="com.timepieces.automation.listeners.RetryAnnotationTransformer" />
        <listener class-name="com.timepieces.automation.listeners.MetricsListener" />
    </listeners>

    <!-- Global Parameter read by BaseRunner -->
    <parameter name="environment" value="staging" />

    <test name="Smoke Executions">
        <classes>
            <class name="com.timepieces.automation.bdd.runners.SmokeRunner" />
        </classes>
    </test>

    <test name="Regression Executions">
        <classes>
            <class name="com.timepieces.automation.bdd.runners.RegressionRunner" />
        </classes>
    </test>

    <!-- TDD UI smokes (2026-07-16, handover mandate): ALL tests run in the
         default suite so local, docker and the staging PR/nightly CI cover them.
         The per-suite testng-*-smoke.xml files remain for isolated runs. -->
    <test name="UI Smoke Executions (TDD)">
        <classes>
            <class name="com.timepieces.automation.tdd.ui.AccessoryPdpSmokeTest" />
            <class name="com.timepieces.automation.tdd.ui.Phase3ContentSmokeTest" />
            <class name="com.timepieces.automation.tdd.ui.TimepiecesWorldSmokeTest" />
            <class name="com.timepieces.automation.tdd.ui.HomepageContentSmokeTest" />
            <class name="com.timepieces.automation.tdd.ui.BecomeMoreSmokeTest" />
        </classes>
    </test>

    <test name="API Executions">
        <classes>
            <class name="com.timepieces.automation.tdd.api.SearchApiTest" />
            <class name="com.timepieces.automation.tdd.api.IdempotencyApiTest" />
        </classes>
    </test>

    <test name="Unit Executions">
        <classes>
            <class name="com.timepieces.automation.tdd.api.TwilioServiceTest" />
        </classes>
    </test>
</suite>