<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
    BDD-only suite: Cucumber feature files driven by the TestNG runners.
    Run with:  ./mvnw clean test "-Dsurefire.suite=testng-bdd.xml"
    Tag filtering (@Smoke / @Regression) lives on each runner; both runners are
    included here so the full Gherkin scope executes. The runners self-deconflict
    overlapping scenarios (see RegressionRunner notes).
-->
<suite name="Timepieces BDD Suite" parallel="none" data-provider-thread-count="2">

    <listeners>
        <listener class-name="com.timepieces.automation.listeners.RetryAnnotationTransformer" />
        <listener class-name="com.timepieces.automation.listeners.MetricsListener" />
    </listeners>

    <!-- Global Parameter read by BaseRunner -->
    <parameter name="environment" value="staging" />

    <test name="Smoke Executions">
        <classes>
            <class name="com.timepieces.automation.bdd.runners.SmokeRunner" />
        </classes>
    </test>

    <test name="Regression Executions">
        <classes>
            <class name="com.timepieces.automation.bdd.runners.RegressionRunner" />
        </classes>
    </test>
</suite>
