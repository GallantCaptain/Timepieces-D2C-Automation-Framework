  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "title": "Total Test Runs",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "postgres_metrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres_metrics"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) FROM test_runs",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "id": 2,
      "title": "Overall Success Rate",
      "type": "gauge",
      "datasource": {
        "type": "postgres",
        "uid": "postgres_metrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres_metrics"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT (SUM(passed_scenarios)::float / NULLIF(SUM(total_scenarios), 0)) * 100 AS value FROM test_runs",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 80
              },
              {
                "color": "green",
                "value": 95
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "id": 3,
      "title": "Pass/Fail Scenarios Over Time",
      "type": "barchart",
      "datasource": {
        "type": "postgres",
        "uid": "postgres_metrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres_metrics"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT run_timestamp AS time, passed_scenarios AS passed, failed_scenarios AS failed FROM test_runs ORDER BY run_timestamp ASC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "passed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "failed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "id": 4,
      "title": "Execution Duration Trend (Seconds)",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "postgres_metrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres_metrics"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT run_timestamp AS time, duration_seconds AS value, browser AS metric FROM test_runs ORDER BY run_timestamp ASC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          }
        },
        "overrides": []
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "id": 5,
      "title": "Latest Test Executions (Top 10)",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "postgres_metrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres_metrics"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT build_id AS \"Build ID\", environment AS \"Env\", browser AS \"Browser\", total_scenarios AS \"Total\", passed_scenarios AS \"Passed\", failed_scenarios AS \"Failed\", duration_seconds AS \"Duration (s)\", run_timestamp AS \"Run Time\" FROM test_runs ORDER BY run_timestamp DESC LIMIT 10",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "displayMode": "auto"
          }
        },
        "overrides": []
      }
    }
  ],
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["testing", "metrics", "qa"],
  "title": "Timepieces Test Execution Dashboard",
  "uid": "timepieces_qa_dashboard",
  "version": 1
}
