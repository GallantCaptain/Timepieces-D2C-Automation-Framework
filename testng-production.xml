<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Production nightly suite. Selected by the production-tests workflow via
  -Dsurefire.suite=testng-production.xml. Runs ONLY the ProductionRunner, which is
  scoped to @ProdReady (non-login) scenarios — see ProductionRunner javadoc.
-->
<suite name="Timepieces Production Suite" parallel="none" data-provider-thread-count="2">

    <listeners>
        <listener class-name="com.timepieces.automation.listeners.RetryAnnotationTransformer" />
        <listener class-name="com.timepieces.automation.listeners.MetricsListener" />
    </listeners>

    <!-- Global Parameter read by BaseRunner -->
    <parameter name="environment" value="production" />

    <test name="Production Non-Login Executions">
        <classes>
            <class name="com.timepieces.automation.runners.ProductionRunner" />
        </classes>
    </test>
</suite>
