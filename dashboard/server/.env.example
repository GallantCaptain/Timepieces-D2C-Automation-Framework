# ---- Timepieces Dashboard API config ----
# Copy to .env and fill in. Never commit the real .env.

# HTTP
PORT=4000
# Comma-separated list of allowed browser origins for CORS (the web app's URL).
CORS_ORIGIN=http://localhost:5173

# Auth
# Long random string used to sign JWTs. Generate e.g. `openssl rand -hex 32`.
JWT_SECRET=change-me-to-a-long-random-string
# Token lifetime, e.g. 12h, 7d.
JWT_EXPIRES_IN=12h

# Database — reuses the same Postgres that stores test_runs.
# Either a full connection URL (Neon/local) ...
DATABASE_URL=postgres://postgres:devpassword@localhost:5432/timepieces_metrics
# ... the publisher also reads NEON_DATABASE_URL; DATABASE_URL takes precedence here.

# GitHub Actions dispatch (to run flows on demand)
# A fine-grained or classic PAT with `actions:write` (and `repo` for private repos).
GITHUB_TOKEN=
GITHUB_OWNER=TimepiecesTech
GITHUB_REPO=qa-automation
# Workflow file name as it lives in .github/workflows/
GITHUB_WORKFLOW_FILE=test-pipeline.yml
# Git ref the workflow_dispatch runs against.
GITHUB_DEFAULT_REF=main